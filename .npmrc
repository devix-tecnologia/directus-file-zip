# pnpm configuration
auto-install-peers=true
strict-peer-dependencies=false

registry=https://registry.npmjs.org/


# Note: pnpm doesn't have native "minimum package age" filtering
# Age filtering is handled by:
# - Dependabot: configured in .github/dependabot.yml (weekly updates)
# - Manual updates: use .github/scripts/checkPackageAge.js to verify age before updating
