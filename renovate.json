{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "description": "Note: Security fixes for transitive dependencies are managed via pnpm.overrides in package.json",
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "dependencyDashboard": true,
  "schedule": ["before 6am on monday"],
  "timezone": "America/Sao_Paulo",
  "labels": ["dependencies"],
  "assignees": ["@robertoseba", "@sidartaveloso"],
  "packageRules": [
    {
      "description": "Directus packages - wait 5 days before updating",
      "matchPackagePatterns": ["^@?directus"],
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Security updates - adopt immediately",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "minimumReleaseAge": "0 days",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Development dependencies - wait 3 days",
      "matchDepTypes": ["devDependencies"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Production dependencies - wait 5 days",
      "matchDepTypes": ["dependencies"],
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Major updates - wait 7 days and require manual review",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "7 days",
      "automerge": false
    },
    {
      "description": "Group all non-major updates together",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
