{
  "name": "@devix-tecnologia/directus-file-zip",
  "version": "2.7.0",
  "description": "Creates a zip from files and saves to Directus Assets.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/cjs/types/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devix-tecnologia/directus-file-zip.git"
  },
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:single": "vitest run --reporter=verbose",
    "clean": "rm -rf ./dist",
    "build": "pnpm run clean && pnpm run build:esm",
    "build:esm": "tsc -p ./tsconfig.esm.json && mv dist/esm/index.js dist/esm/index.mjs",
    "prepack": "pnpm run build",
    "semantic-release": "semantic-release",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit -p ./tsconfig.esm.json",
    "validate": "directus-extension validate"
  },
  "author": "Devix Tecnologia Ltda.",
  "contributors": [
    {
      "name": "Roberto Seba",
      "email": "roberto@robertoseba.com",
      "url": "https://github.com/robertoseba"
    },
    {
      "name": "Sidarta Veloso",
      "email": "sidartaveloso@gmail.com",
      "url": "https://github.com/sidartaveloso"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@directus/api": "^35.1.0",
    "@directus/extensions": "^3.0.24",
    "@directus/types": "^15.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.6.0",
    "assert": "^2.1.0",
    "dotenv": "^17.4.2",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "axios": "^1.15.1",
    "better-sqlite3": "^12.9.0"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": ">=5.5.7",
      "tar": ">=7.5.11",
      "path-to-regexp@<0.1.13": ">=0.1.13",
      "lodash-es": ">=4.18.0",
      "unhead": ">=2.1.13",
      "axios": ">=1.15.0",
      "qs": ">=6.14.2",
      "srvx": ">=0.11.13",
      "@tootallnate/once": ">=3.0.1",
      "pm2": "6.0.14"
    }
  },
  "publishConfig": {
    "type": "git",
    "url": "git+https://github.com/devix-tecnologia/directus-file-zip.git",
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/types/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  }
}
